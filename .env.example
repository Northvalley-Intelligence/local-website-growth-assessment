# App
NEXT_PUBLIC_APP_NAME="Local Website Growth Assessment"
NEXT_PUBLIC_STAGING_URL="https://staging-assessment.northvalleyintel.com"
NEXT_PUBLIC_PRODUCTION_URL="https://assessment.northvalleyintel.com"

# Worker
ASSESSMENT_USER_AGENT="NorthValleyIntelWebsiteAssessmentBot/0.1"
MAX_CRAWL_PAGES="25"
MAX_CRAWL_DEPTH="2"
CRAWL_DELAY_MS="1000"
REQUEST_TIMEOUT_MS="10000"
PAGESPEED_TIMEOUT_MS="45000"
MAX_RESPONSE_BYTES="750000"
MAX_CRAWL_CONCURRENCY="1"
MAX_SCAN_HISTORY="50"

# Optional external API
PAGESPEED_API_KEY=""

# Google Ads API (Keyword Planner volumes — scripts/keyword-volumes.mjs).
# Obtain the refresh token with scripts/get-google-ads-refresh-token.mjs.
# Real values live in .env.local (gitignored) — never commit them.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Optional: a client account under the manager (MCC) account.
# Defaults to GOOGLE_ADS_LOGIN_CUSTOMER_ID when unset.
GOOGLE_ADS_CUSTOMER_ID=""
